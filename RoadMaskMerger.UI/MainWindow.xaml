<Window x:Class="RoadMaskMerger.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoadMaskMerger.UI"
        mc:Ignorable="d"
        Title="Road Mask Merger" Height="720" Width="820" MinHeight="580" MinWidth="700">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3,4,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: standing advice banner -->
            <RowDefinition Height="Auto"/>   <!-- 1: mode selector -->
            <RowDefinition Height="Auto"/>   <!-- 2: mode-specific panel -->
            <RowDefinition Height="Auto"/>   <!-- 3: output section -->
            <RowDefinition Height="Auto"/>   <!-- 4: run row -->
            <RowDefinition Height="*"/>      <!-- 5: log -->
            <RowDefinition Height="Auto"/>   <!-- 6: result bar -->
        </Grid.RowDefinitions>

        <!-- Standing advice (was a "prototype" warning - validated against a real
             1268-plugin profile as of 2026-09-11, so this is now routine guidance,
             not a caveat about the tool's own maturity) -->
        <Border Grid.Row="0" Background="#FF1E1E1E" BorderBrush="#FF3F3F3F" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <TextBlock Foreground="#FFDCDCDC" TextWrapping="Wrap" Margin="0">
                Always review the log (especially any [BOUNDARY] lines - shared cell edges this merge
                made worse) before installing the generated plugin. Test on an isolated install first if
                you're trying a new road-source plugin or worldspace for the first time.
            </TextBlock>
        </Border>

        <!-- Mode selector -->
        <GroupBox Grid.Row="1" Header="Mod manager" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="6">
                <RadioButton x:Name="ModeMo2" Content="Mod Organizer 2" GroupName="Mode" IsChecked="True" Checked="Mode_Checked"/>
                <RadioButton x:Name="ModeVortex" Content="Vortex" GroupName="Mode" Checked="Mode_Checked"/>
                <RadioButton x:Name="ModeDirect" Content="Direct game path (no mod manager)" GroupName="Mode" Checked="Mode_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- Mode-specific panels -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <!-- MO2 panel -->
            <GroupBox x:Name="Mo2Panel" Header="Mod Organizer 2 settings">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="MO2 instance folder:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="Mo2InstancePathBox" TextChanged="Mo2InstancePathBox_TextChanged"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="Mo2BrowseInstance_Click"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Mo2ProfileCombo"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="(auto-listed from instance)" Foreground="Gray" FontSize="11"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Game Data folder:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="Mo2GameDataPathBox"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="Mo2BrowseGameData_Click"/>

                    <Expander Grid.Row="3" Grid.ColumnSpan="3" Header="Advanced: explicit profile file paths" Margin="0,6,0,0">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="plugins.txt:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="Mo2PluginsTxtBox"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Click="Mo2BrowsePluginsTxt_Click"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="loadorder.txt:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Mo2LoadOrderTxtBox"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="Mo2BrowseLoadOrderTxt_Click"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="modlist.txt:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="Mo2ModlistTxtBox"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="Mo2BrowseModlistTxt_Click"/>
                        </Grid>
                    </Expander>
                </Grid>
            </GroupBox>

            <!-- Vortex panel -->
            <GroupBox x:Name="VortexPanel" Header="Vortex settings" Visibility="Collapsed">
                <StackPanel Margin="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Game Data folder:"/>
                        <TextBox Grid.Column="1" x:Name="VortexGameDataPathBox" TextChanged="ModeDataPathBox_TextChanged"/>
                        <Button Grid.Column="2" Content="Browse..." Click="VortexBrowseGameData_Click"/>
                    </Grid>
                    <Button Content="Auto-detect from Vortex" HorizontalAlignment="Left" Click="VortexAutoDetect_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Direct panel -->
            <GroupBox x:Name="DirectPanel" Header="Direct game path" Visibility="Collapsed">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Game Data folder:"/>
                    <TextBox Grid.Column="1" x:Name="DirectGameDataPathBox" TextChanged="ModeDataPathBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Browse..." Click="DirectBrowseGameData_Click"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- Output -->
        <GroupBox Grid.Row="3" Header="Output" Margin="0,0,0,10">
            <StackPanel Margin="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output folder:"/>
                    <TextBox Grid.Column="1" x:Name="OutputFolderBox" TextChanged="OutputFolderBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Browse..." Click="OutputBrowse_Click"/>
                </Grid>
                <TextBlock x:Name="OutputHintText" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <!-- Run row -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Road-source plugin:"/>
                <TextBox Grid.Column="1" x:Name="RoadSourceBox" Text="Northern Roads.esp"
                         ToolTip="The plugin whose own terrain is used wherever the road mask says a road/path runs."/>
                <TextBlock Grid.Column="3" Text="Worldspace:"/>
                <TextBox Grid.Column="4" x:Name="WorldspaceBox" Text="Tamriel"
                         ToolTip="Restrict to one worldspace's EditorID (case-insensitive) - required, since the road mask is per-worldspace."/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ACMOS roads folder:"/>
                <TextBox Grid.Column="1" x:Name="AcmosRoadsBox"
                         ToolTip="Defaults to the bundled copy shipped alongside this app (Assets\ACMOS-roads) - change only if you want a different/updated ACMOS road-mask set."/>
                <Button Grid.Column="2" Content="Browse..." Click="AcmosBrowse_Click"/>
            </Grid>
            <CheckBox x:Name="PathsOnlyCheck" Content="Use &quot;Paths Only&quot; mask instead of &quot;Roads&quot; (footpaths, not major roads)" Margin="0,0,0,4"/>
            <Border Background="#FF4A3B00" BorderBrush="#FFC9A200" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                <TextBlock Foreground="#FFFFD966" TextWrapping="Wrap" FontSize="11" Margin="0">
                    Only use "Paths Only" with a road-source plugin whose real terrain edits are
                    themselves scoped to footpaths - NOT with a full road-carving mod like Northern
                    Roads. This tool only merges where the mask says a path/road runs AND the road-
                    source plugin genuinely edited that exact spot; if the plugin carved a MAJOR road
                    but the mask only marks minor paths, cells along that road get skipped entirely
                    while neighboring cells (that do have a marked path) still merge - a patchwork of
                    merged and un-merged cells that reads as holes in-game. Use the default "Roads"
                    mask for any mod that reshapes real road-width terrain.
                </TextBlock>
            </Border>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6">
                Merges the road-source plugin's own terrain height into whatever mod currently wins each cell,
                restricted to wherever the road mask says a road/path runs (and only where the road-source
                plugin actually edited that exact spot vs. vanilla). Always writes a NEW plugin; nothing else
                is touched. There is no separate detection step - this always generates the merge plugin directly.
            </TextBlock>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Generate Merge Plugin" Padding="20,6" FontWeight="Bold" Click="RunButton_Click"/>
                <ProgressBar x:Name="RunProgress" Width="200" Height="20" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Log -->
        <GroupBox Grid.Row="5" Header="Log">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#FF1E1E1E" Foreground="#FFDCDCDC"
                     BorderThickness="0"/>
        </GroupBox>

        <!-- Result bar -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="ResultText" Text="" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="OpenFixPluginButton" Content="Open Merge Plugin" IsEnabled="False" Click="OpenFixPluginButton_Click" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="OpenFolderButton" Content="Open Folder" IsEnabled="False" Click="OpenFolderButton_Click"/>
        </Grid>
    </Grid>
</Window>
